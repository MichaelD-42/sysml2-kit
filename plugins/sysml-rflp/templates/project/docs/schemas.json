{
  "schemas": [
    {
      "id": "crs-class",
      "message": "Customer requirement has no class",
      "select": {
        "properties": {
          "type": {
            "enum": [
              "crs",
              "prq"
            ]
          }
        }
      },
      "validate": {
        "local": {
          "properties": {
            "class": {
              "enum": [
                "functional",
                "non-functional",
                "constraint",
                "information"
              ]
            }
          },
          "required": [
            "class"
          ]
        }
      }
    },
    {
      "id": "crs-satisfied",
      "message": "Customer requirement is not satisfied by any system requirement or constraint",
      "select": {
        "properties": {
          "type": {
            "enum": [
              "crs",
              "prq"
            ]
          },
          "scope": {
            "const": ""
          },
          "class": {
            "enum": [
              "functional",
              "non-functional",
              "constraint"
            ]
          }
        }
      },
      "validate": {
        "network_back": {
          "satisfies": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "enum": [
                      "sysreq",
                      "constraint"
                    ]
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
