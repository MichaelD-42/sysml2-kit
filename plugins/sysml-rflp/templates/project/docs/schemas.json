{
  "schemas": [
    {
      "id": "crs-satisfied",
      "message": "Customer requirement is not satisfied by any system requirement",
      "select": {
        "properties": {
          "type": {
            "const": "crs"
          }
        }
      },
      "validate": {
        "network_back": {
          "satisfies": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "sysreq"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "crs-verified",
      "message": "Customer requirement is not verified by any acceptance test",
      "select": {
        "properties": {
          "type": {
            "const": "crs"
          }
        }
      },
      "validate": {
        "network_back": {
          "verifies": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "acctest"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "usecase-realizes",
