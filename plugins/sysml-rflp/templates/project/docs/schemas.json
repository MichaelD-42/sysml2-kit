          },
          "leaf": {
            "const": true
          }
        }
      },
      "validate": {
        "network_back": {
          "allocated_to": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "function"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
