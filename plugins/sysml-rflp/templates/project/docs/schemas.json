          }
        }
      }
    },
    {
      "id": "function-allocated",
      "message": "Leaf function must be allocated to exactly one logical component",
      "select": {
        "properties": {
          "type": {
            "const": "function"
          },
          "leaf": {
            "const": true
          }
        }
      },
      "validate": {
        "network": {
          "allocated_to": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "component"
                  }
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "id": "component-used",
      "message": "Leaf logical component has no function allocated",
      "select": {
        "properties": {
          "type": {
