    },
    {
      "id": "acctest-verifies",
      "message": "Acceptance test does not verify a customer requirement or use case",
      "select": {
        "properties": {
          "type": {
            "const": "acctest"
          }
        }
      },
      "validate": {
        "network": {
          "verifies": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "enum": [
                      "crs",
                      "usecase"
                    ]
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    }
  ]
